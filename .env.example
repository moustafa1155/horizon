# Private MongoDB connection settings
MONGODB_URI=
MONGODB_DATABASE=taste_the_best

# Exact HTTPS origin on hosting; no trailing slash. Leave empty for localhost.
APP_ORIGIN=

# Bunny storage (server only; never use NEXT_PUBLIC_ for the password)
BUNNY_STORAGE_ZONE=taste-midea-storage
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_PASSWORD=
